rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Membre d'une liste = possède un document lists/{id}/members/{son uid}
    function isMember(listId) {
      return signedIn()
        && exists(/databases/$(database)/documents/lists/$(listId)/members/$(request.auth.uid));
    }

    // Profil + jetons de notification : chacun ne voit que les siens
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      // Index personnel de mes listes
      match /myLists/{listId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /lists/{listId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if isMember(listId);
      allow update: if isMember(listId) && resource.data.ownerId == request.auth.uid;

      // Rejoindre = créer son propre document membre.
      // Le code de la liste EST l'identifiant de la liste : sans lui, impossible de la trouver.
      match /members/{uid} {
        allow read: if isMember(listId) || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn()
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/lists/$(listId));
        allow update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notify', 'name']);
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // Les cadeaux souhaités : visibles par tous les membres, modifiables par leur propriétaire
      match /gifts/{giftId} {
        allow read: if isMember(listId);
        allow create: if isMember(listId) && request.resource.data.ownerId == request.auth.uid;
        allow update: if isMember(listId)
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId;
        allow delete: if isMember(listId) && resource.data.ownerId == request.auth.uid;
      }

      // Les achats : JAMAIS lisibles par la personne à qui le cadeau est destiné.
      // Rangés par destinataire (purchases/{destinataire}/items/{cadeau}) : la règle porte sur
      // le chemin lui-même, donc impossible pour le destinataire de lire ce dossier.
      match /purchases/{ownerUid}/items/{giftId} {
        allow read: if isMember(listId) && ownerUid != request.auth.uid;
        allow create: if isMember(listId)
          && ownerUid != request.auth.uid
          && request.resource.data.boughtBy == request.auth.uid
          && get(/databases/$(database)/documents/lists/$(listId)/gifts/$(giftId)).data.ownerId == ownerUid;
        allow delete: if isMember(listId) && resource.data.boughtBy == request.auth.uid;
      }
    }
  }
}
